+class _OffloadTap:
+    """Observe after Accelerate materializes weights and before it offloads them."""
+    def __init__(self, module, hook):
+        self.module, self.original = module, module._old_forward
+        def forward(*args, **kwargs):
+            hook(module, args)
+            return self.original(*args, **kwargs)
+        module._old_forward = forward
+
+    def remove(self):
+        self.module._old_forward = self.original
+
+
+def _router_hook(stats, row, probability):
+    def hook(module, args, output):
+        logits = output[0].detach().float()
+        probs = logits.sigmoid() if probability == "sigmoid" else logits.softmax(dim=-1)
+        stats.tensors["prob_mass"][row] += probs.sum(dim=0)
+    return hook
+
