<Window x:Class="TrainingStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Training Studio" Width="1220" Height="880" MinWidth="920" MinHeight="680" Background="#F4F6FA" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14" Foreground="#192637" WindowStartupLocation="CenterScreen">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22">
   <Border DockPanel.Dock="Left" Background="#155C49" CornerRadius="12" Width="44" Height="44" Margin="0,0,14,0"><TextBlock Text="↗" Foreground="White" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel DockPanel.Dock="Left"><TextBlock Text="Training Studio" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Local models. Measured progress." Foreground="#526174"/></StackPanel>
   <TextBlock x:Name="ConnectionBadge" Text="Connect your WSL backend" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#526174"/>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="Controls">
     <Button x:Name="ResumeButton" Content="▶  Start / Resume" Click="Resume_Click" AutomationProperties.AutomationId="Resume"/>
     <Button x:Name="PauseButton" Content="Ⅱ  Pause for gaming" Click="Pause_Click" AutomationProperties.AutomationId="Pause"/>
     <Button x:Name="StopButton" Content="Stop" Click="Stop_Click"/>
    </StackPanel>
    <ComboBox x:Name="SessionPicker" MinWidth="200" MaxWidth="300" HorizontalAlignment="Left" SelectionChanged="Session_Changed" AutomationProperties.Name="Experiment"/>
   </DockPanel>
  </Border>
  <TabControl Grid.Row="2" x:Name="Tabs" Background="Transparent" BorderThickness="0">
   <TabItem Header="Overview">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,6,0">
     <Border x:Name="QualityCard" Style="{StaticResource Card}" Background="#EDF4F1">
      <StackPanel><TextBlock Text="IS THE MODEL GETTING BETTER?" Foreground="#526174" FontSize="12" FontWeight="SemiBold"/>
       <TextBlock x:Name="QualityTitle" Text="Not yet measured" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,8"/>
       <TextBlock x:Name="QualityDetail" Text="Complete the baseline and trained benchmarks to measure a change."/>
       <TextBlock Text="Scores describe these coding tests. More checkpoints or lower loss do not prove better coding. The current model is not replaced automatically." Foreground="#526174" FontSize="12" Margin="0,12,0,0"/>
      </StackPanel>
     </Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Current activity" Style="{StaticResource Heading}"/>
       <TextBlock x:Name="Activity" Text="Waiting for connection" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock x:Name="ActivityDetail" Margin="0,8,0,12"/>
       <ProgressBar x:Name="StageProgress" Height="8" Minimum="0" Maximum="100"/>
       <TextBlock x:Name="ProgressText" Foreground="#526174" Margin="0,8,0,8"/>
       <TextBlock x:Name="Clocks" Foreground="#526174"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="GPU" Style="{StaticResource Heading}"/>
       <TextBlock x:Name="GpuName" Text="Not connected" FontWeight="SemiBold"/>
       <TextBlock x:Name="GpuMemory" Margin="0,12,0,8"/>
       <ProgressBar x:Name="Vram" Height="8" Maximum="100"/>
       <TextBlock x:Name="GpuUsage" Margin="0,12,0,0" Foreground="#526174"/>
      </StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Benchmark comparison" Style="{StaticResource Heading}"/>
      <TextBlock x:Name="ChartHint" Text="Completed measurements will appear here. Partial scores are not improvements." Foreground="#526174" Margin="0,0,0,12"/>
      <StackPanel x:Name="Chart"/>
      <DataGrid x:Name="LanguageGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="240" BorderThickness="0"/>
      <Button Content="Export private result report…" Click="Export_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Activity &amp; checkpoints">
    <Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
     <TextBlock Text="Live worker output · refreshes every 5 seconds" Style="{StaticResource Heading}"/>
     <TextBox x:Name="Logs" Grid.Row="1" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="#172333" Foreground="#E3EBF5" Padding="16" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Worker log"/>
     <ListBox Grid.Row="2" x:Name="Checkpoints" Margin="0,14,0,0" AutomationProperties.Name="Saved checkpoints"/>
    </Grid>
   </TabItem>
   <TabItem Header="History">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="0,20,6,0"><StackPanel>
     <TextBlock Text="Measured progress across experiments" Style="{StaticResource Heading}"/>
     <TextBlock Text="Each bar shows the change from that experiment's own baseline. Different datasets or settings are not a direct model ranking. Unfinished runs have no quality score." Foreground="#526174" Margin="0,0,0,16"/>
     <StackPanel x:Name="HistoryChart"/>
     <DataGrid x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" HeadersVisibility="Column"/>
    </StackPanel></Border></ScrollViewer>
   </TabItem>
   <TabItem Header="New experiment">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="0,20,6,0"><StackPanel MaxWidth="720" HorizontalAlignment="Left">
     <TextBlock Text="Prepare a measured training run" Style="{StaticResource Heading}"/>
     <TextBlock Text="1   Model and recipe" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <ComboBox x:Name="ModelPicker" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="Qwen3.5-4B · BF16 LoRA · NVIDIA 16 GB"/></ComboBox>
     <TextBlock Text="This release supports the tested Go / TypeScript repair recipe. It runs all 790 Python, Go, TypeScript, Rust and Dart benchmark tasks before and after training. Other model architectures are not supported yet." Foreground="#526174" Margin="0,0,0,20"/>
     <Label Target="{Binding ElementName=ExperimentName}" Content="Experiment name"/><TextBox x:Name="ExperimentName" Style="{StaticResource Field}" Text="coding-trial"/>
     <TextBlock Text="2   Import private training data" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="Choose a Linux JSONL path with its adjacent .manifest.json file. The recipe requires verified provenance, a training-only split, at least 2,000 examples and 250 per language. Validation checks the supplied evidence; it does not replay publisher tests." Foreground="#526174"/>
     <Label Target="{Binding ElementName=DatasetPath}" Content="Dataset path inside WSL"/><TextBox x:Name="DatasetPath" Style="{StaticResource Field}"/>
     <Button Content="Validate and preview data" Click="ValidateData_Click" HorizontalAlignment="Left"/>
     <TextBlock x:Name="DatasetPreview" Margin="0,12,0,20" Foreground="#526174"/>
     <TextBlock Text="3   Training time limit" FontWeight="SemiBold"/>
     <ComboBox x:Name="Hours" SelectedIndex="2" Width="200" HorizontalAlignment="Left" Margin="0,10,0,16"><ComboBoxItem Content="1 hour" Tag="1"/><ComboBoxItem Content="3 hours" Tag="3"/><ComboBoxItem Content="6 hours" Tag="6"/></ComboBox>
     <TextBlock Text="One training pass at most. Benchmark time is separate. Pause preserves progress. The new experiment starts paused, and no adapter replaces your current model automatically." Foreground="#526174" Margin="0,0,0,16"/>
     <Button Content="Create paused experiment" Click="Create_Click" HorizontalAlignment="Left"/>
    </StackPanel></Border></ScrollViewer>
   </TabItem>
   <TabItem Header="Startup">
    <Border Style="{StaticResource Card}" Margin="0,20,6,0" VerticalAlignment="Top"><StackPanel>
     <TextBlock Text="Choose what starts with Windows" Style="{StaticResource Heading}"/>
     <CheckBox x:Name="AutoLearning" Content="Resume learning automatically after Windows login" Margin="0,8,0,10"/>
     <TextBlock Text="When enabled, unfinished experiments recover after login or an unexpected worker exit. Saved Pause, Stop and completed runs stay respected." Foreground="#526174" Margin="24,0,0,24"/>
     <CheckBox x:Name="AutoStudio" Content="Open Training Studio after Windows login" Margin="0,8,0,10"/>
     <TextBlock Text="This only opens the app. It does not start training when automatic learning is off." Foreground="#526174" Margin="24,0,0,24"/>
     <Button Content="Save startup preferences" Click="Startup_Click" HorizontalAlignment="Left"/>
     <TextBlock x:Name="StartupSummary" Margin="0,20,0,12"/>
     <TextBlock Text="With automatic learning off, there are no login or timer starts: use Start / Resume yourself. Changing these settings does not pause or stop work already running." Foreground="#526174"/>
    </StackPanel></Border>
   </TabItem>
   <TabItem Header="Connection">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="0,20,6,0"><StackPanel MaxWidth="720" HorizontalAlignment="Left">
     <TextBlock Text="Your local WSL backend" Style="{StaticResource Heading}"/>
     <TextBlock Text="Connect to a prepared Local Coding Assistant checkout in WSL. Training uses its NVIDIA CUDA environment. Connection settings stay in your Windows user profile." Foreground="#526174" Margin="0,0,0,16"/>
     <Label Target="{Binding ElementName=Distro}" Content="WSL distribution"/><ComboBox x:Name="Distro" IsEditable="True" MinWidth="500" Margin="0,6,0,12"/>
     <Button Content="Find WSL distributions" Click="Detect_Click" HorizontalAlignment="Left"/>
     <Label Target="{Binding ElementName=LinuxUser}" Content="Linux user"/><TextBox x:Name="LinuxUser" Style="{StaticResource Field}"/>
     <Label Target="{Binding ElementName=ProjectRoot}" Content="Absolute Linux project folder"/><TextBox x:Name="ProjectRoot" Style="{StaticResource Field}"/>
     <Label Target="{Binding ElementName=PythonPath}" Content="Controller Python path, relative to the project or absolute"/><TextBox x:Name="PythonPath" Style="{StaticResource Field}"/>
     <Button Content="Save and connect" Click="Connect_Click" HorizontalAlignment="Left"/>
     <TextBlock Text="Closing this window leaves training running. Start / Resume creates a background task when needed. Choose login behavior in Startup. Saved Pause and Stop stay respected." Foreground="#526174" Margin="0,20,0,12"/>
     <Button Content="Open setup guide" Click="Help_Click" HorizontalAlignment="Left"/>
    </StackPanel></Border></ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="3" Background="#E9EEF5" CornerRadius="8" Padding="12" Margin="0,16,0,0"><TextBlock x:Name="Notice" Text="Your data and model files stay on this PC." TextWrapping="Wrap"/></Border>
 </Grid>
</Window>
